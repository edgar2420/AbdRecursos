# ---- Servidor ----
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1

# ---- Base de datos ----
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sgrh?schema=public"

# ---- Seguridad ----
JWT_ACCESS_SECRET=cambia-esto-en-produccion-access
JWT_REFRESH_SECRET=cambia-esto-en-produccion-refresh
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=12
# Minutos de inactividad tras los cuales se cierra la sesion
SESSION_IDLE_MINUTES=15
# Clave del cifrado de campos sensibles en reposo (cambiar en produccion)
FIELD_ENCRYPTION_KEY=cambia-esta-clave-de-cifrado-en-produccion

# ---- HTTPS ----
HTTPS_ENABLED=true
HTTPS_KEY_PATH=./certs/sgrh-key.pem
HTTPS_CERT_PATH=./certs/sgrh-cert.pem

# ---- CORS (lista separada por comas, nunca *) ----
CORS_ORIGINS=https://localhost:4200

# ---- Rate limiting ----
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
LOGIN_RATE_LIMIT_MAX=5

# ---- Uploads ----
UPLOAD_MAX_MB=10
UPLOAD_DIR=./storage/uploads

# ---- Empresa (datos para la boleta) ----
COMPANY_NAME=ABD S.R.L.
COMPANY_NIT=0000000000
COMPANY_CITY=La Paz - Bolivia
